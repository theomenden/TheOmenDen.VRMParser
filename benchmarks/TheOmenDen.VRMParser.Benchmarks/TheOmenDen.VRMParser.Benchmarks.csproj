<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<!-- BenchmarkDotNet refuses to produce trustworthy numbers outside an optimized build. -->
		<Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
	</PropertyGroup>

	<PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
		<!-- Gates the ETW HardwareCounters/EtwProfiler code, which only exists in the Windows diagnostics package. -->
		<DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\TheOmenDen.VRMParser\TheOmenDen.VRMParser.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="BenchmarkDotNet" />
	</ItemGroup>

	<!-- ETW hardware counters / EtwProfiler are Windows + admin only; keep them off Linux CI. -->
	<ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
		<PackageReference Include="BenchmarkDotNet.Diagnostics.Windows" />
	</ItemGroup>

	<ItemGroup>
		<!-- Reuse the test project's committed fixtures as benchmark inputs (single source of truth). -->
		<None Include="..\..\tests\TheOmenDen.VRMParser.Tests\Fixtures\*.glb;..\..\tests\TheOmenDen.VRMParser.Tests\Fixtures\*.vrm"
		      Link="Fixtures\%(Filename)%(Extension)"
		      CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
