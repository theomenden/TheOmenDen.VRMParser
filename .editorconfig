root = true

# Source-generated Corvus.Text.Json files.
# The V5 source generator emits calls to its own [Obsolete] ParseValue(...) API
# (a pooled-memory change in 5.x). That's generated-code-only noise we don't control,
# so silence CS0618 here ONLY — hand-written code still gets the warning.
[*.g.cs]
generated_code = true
dotnet_diagnostic.CS0618.severity = none

# Library code: enforce async hygiene (tests/benchmarks are exempt — they own their sync context).
[TheOmenDen.VRMParser/**/*.cs]
dotnet_diagnostic.CA2007.severity = warning   # ConfigureAwait(false) on every await
dotnet_diagnostic.CA1849.severity = warning   # don't call sync APIs in async methods
dotnet_diagnostic.CA2016.severity = warning   # forward the CancellationToken

# Verify snapshots
[*.{received,verified}.{json,txt}]
charset = utf-8-bom
end_of_line = lf
indent_size = unset
indent_style = unset
insert_final_newline = false
tab_width = unset
trim_trailing_whitespace = false
